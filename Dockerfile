RUN python /runner/job.py
FROM python:3.12-slim-bookworm AS server
WORKDIR /runner
COPY server.py /runner/server.py
COPY --from=builder /out /out
ENV PYTHONUNBUFFERED=1
EXPOSE 10000
CMD ["python", "/runner/server.py"]
